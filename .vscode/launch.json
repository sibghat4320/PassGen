{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run passgen",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/passgen"
    },
    {
      "name": "Run passgen (with flags)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/passgen",
      "args": ["--length", "24", "--count", "3", "--strength"]
    },
    {
      "name": "Debug package tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    }
  ]
}
